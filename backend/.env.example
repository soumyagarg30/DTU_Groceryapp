APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=8
PROVIDER_HEADLESS=false
PROVIDER_USE_PERSISTENT_CONTEXT=true
PROVIDER_BROWSER_CHANNEL=chrome
PROVIDER_MANUAL_BOOTSTRAP=false
PROVIDER_DEBUG=false
CACHE_TTL_SECONDS=180
HOT_QUERY_CACHE_MAX_ENTRIES=20
TOP_K_RESULTS=15
MATCH_HIGH_THRESHOLD=0.85
MATCH_MIN_THRESHOLD=0.72
# Development defaults to demo data. Set false to opt into live provider checks.
USE_MOCK_PROVIDERS=true
